FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
COPY whatsapp-mcp-server/ ./
RUN uv sync --frozen --no-dev
ENV WHATSAPP_MCP_TRANSPORT=http
ENV WHATSAPP_MCP_HOST=0.0.0.0
ENV WHATSAPP_MCP_PORT=8000
ENV WHATSAPP_DB_PATH=/data/messages.db
ENV WHATSMEOW_DB_PATH=/data/whatsapp.db
ENV WHATSAPP_API_URL=http://bridge:8080/api
EXPOSE 8000
CMD ["uv","run","main.py"]

# eMudhra incident 2026-10-22: retain after ordinary source rebuilds.
COPY .security/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY .security/ca-certificates.crt /usr/local/lib/python3.12/site-packages/pip/_vendor/certifi/cacert.pem
COPY .security/ca-certificates.crt /app/.venv/lib/python3.11/site-packages/certifi/cacert.pem
LABEL lab.trust-maintenance="2026-10-22"
